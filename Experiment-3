#include<bits/stdc++.h>
using namespace std;
int main(){
    int n;
    int sum=0;
    int mx=0;
    cin>>n;
    vector<char> arr(n);
    for(int i=0;i<n;i++){
        cin>>arr[i];
    }
    unordered_map<int, int> mp;
    mp[0]=-1;
    for(int i=0;i<n;i++) {
        if(arr[i]=='P'){
            sum+=1;
        }
        else{
            sum-=1;
        }
        if(mp.find(sum)!=mp.end()){
            mx=max(mx, i-mp[sum]);
        } 
        else{
            mp[sum]=i;
        }
    }
    cout<<mx<<endl;
    return 0;
}
