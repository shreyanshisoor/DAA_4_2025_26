class Solution {
  public:
    vector<int> maxOfSubarrays(vector<int>& arr, int k) {
        // code here
        vector<int> count;
        vector<int> num;
        if(k==1){
            return arr;
        }
        else{
            for(int i=0;i<arr.size();i+=3){
                for(int j=0;j<k;j++){
                    num[j]=arr[i];
                }
                int lame=0;
                for(int m=0;m<k;m++){
                    for(int n=lame;n<arr.size()-k+1;i++){
                        if(num[m]>num[m+1]){
                            count[n]=num[m];
                        }
                        else{
                            count[n]=num[m+1];
                        }
                        lame++;
                    }
                }
            }
        }
        return count;
    }
};
