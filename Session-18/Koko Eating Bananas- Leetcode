class Solution {
public:
    int minEatingSpeed(vector<int>& piles, int h) {
        int l = 1;
        int r = 0;
        for (int pile : piles) r = max(r, pile);
        
        int result = r;
        
        while (l <= r) {
            int mid = l + (r - l) / 2;
            
            if (canEatAll(piles, mid, h)) {
                result = mid;
                r = mid - 1;
            } else {
                l = mid + 1;
            }
        }
        return result;
    }

private:
    bool canEatAll(const vector<int>& piles, int k, int h) {
        long long actualHours = 0;
        for (int pile : piles) {
            actualHours += (pile + k - 1) / k;
        }
        return actualHours <= h;
    }
};
