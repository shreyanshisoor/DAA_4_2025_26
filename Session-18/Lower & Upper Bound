#include <iostream>
#include <vector>

using namespace std;

int lowerBound(const vector<int>& a, int key) {
    int l = 0, r = a.size() - 1;
    int ans = a.size();
    
    while (l <= r) {
        int mid = l + (r - l) / 2;
        if (a[mid] >= key) {
            ans = mid;
            r = mid - 1;
        } else {
            l = mid + 1;
        }
    }
    return ans;
}

int upperBound(const vector<int>& a, int key) {
    int l = 0, r = a.size() - 1;
    int ans = a.size();
    
    while (l <= r) {
        int mid = l + (r - l) / 2;
        if (a[mid] > key) {
            ans = mid;
            r = mid - 1;
        } else {
            l = mid + 1;
        }
    }
    return ans;
}

int main() {
    vector<int> a = {1, 2, 3, 4, 4, 4, 5, 6};
    int x;
    
    cout << "Enter the number you want to search: ";
    cin >> x;

    int lb = lowerBound(a, x);
    int ub = upperBound(a, x);

    cout << "Lower Bound Index: " << lb << endl;
    cout << "Upper Bound Index: " << ub << endl;
    
    return 0;
}
