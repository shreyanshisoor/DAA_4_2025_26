class Solution {
public:
    bool isPossible(vector<int>& arr, int k, long long limit) {
        int painters = 1;
        long long currentSum = 0;
        
        for (int i = 0; i < arr.size(); i++) {
            if (currentSum + arr[i] <= limit) {
                currentSum += arr[i];
            } else {
                painters++;
                currentSum = arr[i];
                if (painters > k) return false;
            }
        }
        return true;
    }

    long long minTime(vector<int>& arr, int k) {
        int n = arr.size();
        long long l = 0, r = 0;
        
        for (int i = 0; i < n; i++) {
            l = max(l, (long long)arr[i]);
            r += arr[i];
        }
        
        long long ans = r;
        while (l <= r) {
            long long mid = l + (r - l) / 2;
            
            if (isPossible(arr, k, mid)) {
                ans = mid;
                r = mid - 1;
            } else {
                l = mid + 1;
            }
        }
        return ans;
    }
};
